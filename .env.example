# MongoDB connection (MongoDB Atlas free tier works). Without it the app
# runs on an in-memory store that resets on restart.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=widoph

# Back office (/admin) password. Required in production.
ADMIN_PASSWORD=change-me
# Optional: separate secret for signing admin sessions.
AUTH_SECRET=

# Optional: email the team when a quote request arrives (https://resend.com).
RESEND_API_KEY=
NOTIFY_EMAIL=contact@widophlogistics.com.au
RESEND_FROM=Widoph Quotes <onboarding@resend.dev>
